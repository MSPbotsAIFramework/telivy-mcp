# Optional overrides -- telivy-mcp has no required env vars.
# Authentication is per-request via one request header (Telivy uses a static
# API key, not OAuth), since this server never persists credentials and one
# container serves every tenant concurrently:
#   X-Telivy-Api-Key -- the tenant's Telivy Security API key, forwarded
#     upstream as-is as the "x-api-key" header.
# Get it from: Telivy account -> API settings.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
